{
  "name": "dk-safety-solutions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:city-content",
    "build": "next build",
    "validate:manual-pages": "node scripts/validate-manual-pages.js",
    "validate:service-images": "node scripts/validate-service-images.js",
    "validate:static": "node scripts/validate-static-export.js",
    "validate:city-content": "node scripts/validate-city-content.js",
    "postbuild": "next-sitemap && npm run validate:static && npm run validate:city-content -- --export",
    "serve:out": "node scripts/serve-out.js",
    "start": "node scripts/serve-out.js",
    "export": "npm run build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:carousel": "node --test scripts/test-carousel-gestures.js",
    "build:prod": "npm run build",
    "generate:service-images": "node scripts/generate-service-visuals.js",
    "generate:brand": "node scripts/generate-brand-assets.js"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.1",
    "lucide-react": "^0.575.0",
    "next": "^13.5.11",
    "next-sitemap": "^4.2.3",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "autoprefixer": "^10",
    "cross-env": "^10.1.0",
    "postcss": "^8",
    "sharp": "^0.35.4",
    "tailwindcss": "^3",
    "typescript": "^5"
  }
}
